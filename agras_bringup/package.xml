<?xml version="1.0"?>
<package format="3">
  <name>agras_bringup</name>
  <version>1.0.0</version>
  <description>Launch and configuration for Agras MID360, FAST-LIO2 and LI-Init.</description>
  <maintainer email="tungchiahui@gmail.com">Tung Chia-hui</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>lidar_imu_init</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
